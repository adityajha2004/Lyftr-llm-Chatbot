# Comma-separated key pool (at least 2 keys). Assigned IDs: key_1, key_2, ...
LLM_API_KEYS=your-primary-api-key,your-secondary-api-key

# Default LiteLLM model name (e.g., gemini/gemini-2.0-flash, openai/gpt-4o-mini, groq/llama-3.3-70b-versatile)
LLM_MODEL=gemini/gemini-2.0-flash

# Optional comma-separated per-key model list matching LLM_API_KEYS order
LLM_MODELS=

# SQLite database path (Docker volume mounts at /data)
DATABASE_URL=sqlite:////data/app.db

# Comma-separated CORS origins allowed by the backend
ALLOWED_ORIGINS=http://localhost:3000

# Set to true to enable the X-Simulate-Failure failover test hook
ENABLE_FAILURE_SIMULATION=true

# LiteLLM built-in response caching ("local" for in-memory or "disk")
CACHE_ENABLED=true
CACHE_TYPE=local
DISK_CACHE_DIR=/data/litellm_cache

# Default system prompt when not overridden per session
DEFAULT_SYSTEM_PROMPT=You are a helpful, concise AI assistant.

# Per-key upstream timeout in seconds
REQUEST_TIMEOUT_S=30

# Frontend build-time API base URL
VITE_API_BASE_URL=http://localhost:8000
